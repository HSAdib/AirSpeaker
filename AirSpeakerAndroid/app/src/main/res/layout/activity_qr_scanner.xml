<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.journeyapps.barcodescanner.BarcodeView
        android:id="@+id/barcodeView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.hasan.airspeaker.QrScannerOverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Bar with Dismiss and Title Badge -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#FFFFFF"
        android:contentDescription="Close Scanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTopBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#88000000"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#44FFFFFF"
        app:layout_constraintTop_toTopOf="@id/btnClose"
        app:layout_constraintBottom_toBottomOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan Party QR Code"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Bottom Dock Capsule -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomDock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="#CC141414"
        app:cardElevation="6dp"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <!-- Torch Button -->
            <Button
                android:id="@+id/btnTorch"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="🔦 Flash"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#33FFFFFF"
                android:layout_marginHorizontal="4dp" />

            <!-- Gallery Button -->
            <Button
                android:id="@+id/btnGallery"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="🖼 Photo"
                android:textColor="#00FFCC"
                android:textSize="13sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#33FFFFFF"
                android:layout_marginHorizontal="4dp" />

            <!-- Paste Button -->
            <Button
                android:id="@+id/btnPaste"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="📋 Paste"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
